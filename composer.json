{
  "name": "kernelk14/air-mvc",
  "description": "Air MVC - a lightweight extensible PHP MVC framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.58"
  },
  "autoload": {
    "psr-4": {
      "Air\\": "src/",
      "App\\": "app/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/air"
  ],
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=256M",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "serve": "php -S localhost:8000 index.php"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}